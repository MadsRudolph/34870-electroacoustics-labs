	(text "Lab A Part 4 - Coil in a magnetic field, coupled electro-mechanical (mobility analogy)"
		(at 12.7 10.16 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "3624b89b-0ab0-47d0-9e93-94041e864477")
	)
	(text "Electrical: V1 = 1 V AC, I(Vs1) = coil current i, R1 = Rc = 0.5, L1 = Le = 10u, E1 = back-EMF = Bl*u_c (Bl = 1.5 T m)"
		(at 12.7 15.24 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "a5d3b259-3ac1-481e-aaff-5d5ef4cdeeaa")
	)
	(text "Coupling: G1 = (Bl/Rc)*(V(e_a)-V(e_b)) = Bl*i = coil force (1 A = 1 N), injected into node u_c"
		(at 12.7 19.05 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "fe55cb57-defe-4007-b771-2159a1938bdc")
	)
	(text "Mechanical (mobility): u = V [m/s], f = I [N]; M -> C [F], C_m -> L [H], R_m -> R = 1/R_m [ohm]"
		(at 12.7 22.86 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "37fb5b82-7cd4-4b66-9c71-0a366c51727d")
	)
	(text "C1 = M_mc = 5m, L2 = C_ms = 10u || R2 = 1/R_ms = 1, C2 = M_m1 = 100m, L3 = C_ms2 = 10m, R3 = 1/R_ms2 = 10"
		(at 12.7 26.67 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "76718322-caea-401a-bf2d-8aca0cc90265")
	)
	(text "Z_M seen by the force = Bl*I(Vs1)/V(u_c);  Z_E = V(e_in)/I(Vs1) = 1/I(Vs1)"
		(at 12.7 30.48 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "ca4727c2-84d8-4b75-a596-b80b967df3d5")
	)
